#!/bin/sh
# Pre-commit hook: runs fast checks before allowing commit
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit checks..."

# 1. Go formatting check
echo "  → Checking gofmt..."
UNFORMATTED=$(gofmt -l . 2>/dev/null | grep -v vendor | head -5)
if [ -n "$UNFORMATTED" ]; then
    echo "❌ Files need formatting:"
    echo "$UNFORMATTED"
    echo "Run: gofmt -w ."
    exit 1
fi

# 2. Go vet (fast static analysis)
echo "  → Running go vet..."
go vet ./... 2>&1 || {
    echo "❌ go vet failed"
    exit 1
}

# 3. Build check (catches type errors, missing imports)
echo "  → Building..."
go build ./... 2>&1 || {
    echo "❌ Build failed"
    exit 1
}

# 4. Fast test (no verbose, no race — keep pre-commit fast)
echo "  → Running tests..."
go test -short ./... 2>&1 || {
    echo "❌ Tests failed"
    exit 1
}

echo "✅ All pre-commit checks passed"
